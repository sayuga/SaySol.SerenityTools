<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <SaySolTargetFramework Condition="'$(SaySolTargetFramework)' == ''">net8.0</SaySolTargetFramework>
    <TargetFramework>$(SaySolTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
