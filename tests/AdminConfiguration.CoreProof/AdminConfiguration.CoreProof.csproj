    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tools/AdminConfiguration/dotnet/SaySol.SerenityTools.AdminConfiguration.csproj" />
  </ItemGroup>
</Project>
